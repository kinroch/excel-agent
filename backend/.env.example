# ============================================================
#  Excel 对话式数据分析智能体 · 环境变量样例
#  用法：复制为 backend/.env 并按环境填写；.env 不入版本库（见 .gitignore）
#  配置项来源：《开发技术文档 V1.0.1》10.1「环境与配置清单」
# ============================================================

# ---------- 应用 ----------
DEBUG=false
# 接口基础路径，一般无需修改
API_PREFIX=/api/v1

# ---------- 安全密钥（部署时生成，严禁使用示例值，严禁入库入仓） ----------
# 生成示例：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please-generate-a-random-secret-key
# 用于加密 configs 表中的 LLM api_key（AES-GCM，M3 阶段启用）
AES_KEY=please-generate-a-random-aes-key

# ---------- 登录令牌有效期（F-4.1-3） ----------
ACCESS_TOKEN_EXPIRE_HOURS=12
REMEMBER_TOKEN_EXPIRE_HOURS=168

# ---------- 数据库（默认相对 backend/ 的 data/app.db） ----------
# 留空则使用代码默认值：sqlite:///<backend>/data/app.db
# DATABASE_URL=sqlite:///D:/path/to/backend/data/app.db
DB_ECHO=false

# ---------- 文件目录（留空则使用 backend/uploads、backend/exports） ----------
# UPLOAD_DIR=
# EXPORT_DIR=
MAX_UPLOAD_SIZE_MB=50

# ---------- 异步任务（NFR-P3，默认 2 个 worker） ----------
ANALYSIS_WORKERS=2

# ---------- 跨域（开发期前端 Vite 地址；JSON 数组格式） ----------
CORS_ORIGINS=["http://localhost:5173"]

# ---------- 大模型（默认值；运行时以 configs 表为准，管理端可改） ----------
LLM_CONNECT_TIMEOUT=15
LLM_READ_TIMEOUT=60
LLM_MAX_RETRIES=3
