# ============================================================
#  Excel 对话式数据分析智能体 · 版本控制忽略清单
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/

# 虚拟环境（依赖由 requirements.txt / pyproject.toml 声明，不入库）
.venv/
venv/
env/

# 测试与覆盖率产物
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ---------- Node / 前端 ----------
node_modules/
.vite/
*.tsbuildinfo

# ---------- 本地配置与密钥（严禁提交） ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---------- 运行时产物 ----------
*.log
logs/
tmp/
temp/
uploads/
exports/
data/
*.db
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# ---------- 编辑器 / 操作系统 ----------
.idea/
.DS_Store
Thumbs.db
desktop.ini
